{
  "openapi": "3.0.0",
  "info": { "title": "Pet Store Example", "version": "1.0.0" },
  "paths": {
    "/pets": {
      "post": {
        "operationId": "createPet",
        "summary": "Create a pet",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": { "type": "string" },
                  "tag": { "type": "string" }
                }
              },
              "example": { "name": "", "tag": "" }
            }
          }
        },
        "responses": { "200": { "description": "Created" } }
      },
      "get": {
        "operationId": "listPets",
        "summary": "List pets",
        "responses": { "200": { "description": "OK" } }
      }
    }
  }
}
